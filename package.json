{
  "name": "instant",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "server"
  ],
  "scripts": {
    "build:android": "node scripts/android-app.mjs build",
    "build:android:release": "node scripts/android-app.mjs release",
    "android:signing:init": "node scripts/android-app.mjs signing-init",
    "test:android:downloads": "node --test server/downloads/*.test.mjs",
    "test:gadget-gateway": "node --test server/gadget-gateway/*.test.mjs",
    "deploy:gadget-gateway": "wrangler deploy --cwd server/gadget-gateway",
    "deploy:android:downloads": "wrangler pages deploy --cwd server/downloads --project-name impo-ai --branch main --commit-dirty=true",
    "publish:android": "node scripts/publish-android.mjs",
    "publish:ios:update": "node scripts/publish-ios-update.mjs",
    "test:android": "node scripts/android-app.mjs test",
    "test:android:client": "node scripts/android-app.mjs client-test",
    "lint:android": "node scripts/android-app.mjs lint",
    "android:emulator": "node scripts/android-app.mjs emulator",
    "android:launch": "node scripts/android-app.mjs launch",
    "dev:android-fixture": "node scripts/android-app.mjs fixture",
    "test:android:ui": "node scripts/android-app.mjs smoke",
    "typecheck": "npm --workspace @instant/server run typecheck",
    "test:server": "npm --workspace @instant/server test",
    "dev:fixture": "npm --workspace @instant/server run dev:fixture",
    "test": "node scripts/test.mjs",
    "test:swift": "swift test --package-path ios/Packages/InstantClient",
    "test:e2e": "node scripts/test.mjs --e2e-only",
    "test:ios": "node scripts/test.mjs --ios",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:status": "node scripts/local-db.mjs status",
    "db:push": "npm --workspace @instant/server run db:push",
    "db:seed": "npm --workspace @instant/server run db:seed",
    "dev:api": "npm --workspace @instant/server run dev:api",
    "dev:worker": "npm --workspace @instant/server run dev:worker",
    "test:db": "node scripts/test-db.mjs",
    "test:model-modes:live": "node --env-file-if-exists=.env --import tsx --test server/test/model-modes.live.ts",
    "test:brief:live": "node --env-file-if-exists=.env --import tsx --test server/test/brief-guidance.live.ts",
    "test:model-modes": "node scripts/test-db.mjs --model-modes",
    "test:scheduled-tasks": "node scripts/test-db.mjs --scheduled-tasks",
    "test:devices": "node scripts/test-db.mjs --devices",
    "test:rebyte": "node scripts/test-db.mjs --rebyte",
    "test:live": "node --env-file-if-exists=.env scripts/test-db.mjs --live",
    "test:connectors": "node scripts/test-db.mjs --connectors",
    "test:listening": "node scripts/test-db.mjs --listening",
    "test:listening-batches": "node scripts/test-db.mjs --listening-batches",
    "test:background": "node scripts/test-db.mjs --background",
    "test:today": "node scripts/test-db.mjs --today",
    "test:memory": "node scripts/test-db.mjs --memory",
    "test:echo-schedule": "node scripts/test-db.mjs --echo-schedule",
    "test:notifications": "node scripts/test-db.mjs --notifications",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:accounts": "node scripts/test-db.mjs --accounts",
    "test:attachments": "node scripts/test-db.mjs --attachments"
  }
}
