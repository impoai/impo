{
  "name": "@impo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.*",
    "preview": "vite preview --host 127.0.0.1",
    "astryx": "astryx",
    "format": "prettier --write src test vite.config.ts",
    "theme": "astryx theme build src/theme.ts --out src/generated/impo.css"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.6.5",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.5",
    "@astryxdesign/theme-neutral": "0.6.5",
    "@clerk/react": "6.17.5",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-query": "5.104.1",
    "katex": "0.19.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  }
}
