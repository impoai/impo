# Local development only. Copy to .env; never commit real credentials.
DATABASE_URL=postgresql://instant@127.0.0.1:55432/instant_development
INSTANT_AUTH_MODE=local-dev
INSTANT_RUNTIME=development
PORT=3001
HOST=127.0.0.1
INSTANT_WORKER_POLL_MS=100
WORKER_LEASE_MS=10000
DEVICE_TOOL_TIMEOUT_MS=300000

# Set INSTANT_RUNTIME=rebyte to use the real remote Agent instead of echo.
REBYTE_API_KEY=
REBYTE_BASE_URL=https://api.rebyte.ai/v1
REBYTE_MODEL=gpt-5.6-luna
REBYTE_POLL_MS=500
REBYTE_REQUEST_TIMEOUT_MS=30000

# Optional app connectors (the Rebyte Composio shelf); keep these on the server.
COMPOSIO_API_KEY=
# Every enabled managed auth config named <prefix><toolkit> becomes a connector.
COMPOSIO_AUTH_CONFIG_PREFIX=rebyte-dev-
COMPOSIO_REQUEST_TIMEOUT_MS=20000

# Optional Listening and hold-to-talk transcription; only read by the server. Development runtime uses a deterministic transcriber.
GEMINI_API_KEY=
# VOICE_TRANSCRIPTION_MODEL=gemini-3.5-transcribe

# Optional per-user transcript archive (S3 bucket; ECS task role credentials). Unset = PostgreSQL only.
# TRANSCRIPT_BUCKET=impo-transcripts

# Optional long-term memory (Worker): one Turso database per user in TURSO_GROUP, searched by Gemini embeddings (needs GEMINI_API_KEY).
# TURSO_DB_AUTH_TOKEN is a group token (turso group tokens create <group>). Development runtime uses local files (MEMORY_LOCAL_DIR).
TURSO_API_TOKEN=
TURSO_ORG=
TURSO_GROUP=default
TURSO_DB_AUTH_TOKEN=
# MEMORY_EMBEDDING_MODEL=gemini-embedding-001
# MEMORY_EMBEDDING_DIMENSIONS=768

# Listening batch coordinator. API and Worker must use the same namespace/queue.
# For local QA: temporal server start-dev --port 7239 --headless
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
# LISTENING_TASK_QUEUE=impo-listening-v1

# Remote notifications: Worker only; requires Temporal. Keep the service-account JSON
# in the deployment secret store, never in a client bundle or tracked configuration.
NOTIFICATIONS_ENABLED=false
FCM_SERVICE_ACCOUNT_JSON=
